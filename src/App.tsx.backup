import React, { useState, useEffect } from 'react';
import { LanguageProvider, useLanguage } from './i18n/LanguageContext';
import { ThemeProvider } from './theme/ThemeContext';
import { AuthProvider, useAuth } from './services/authService';
import { StorageService } from './services/storageService';
import { Course, LiveClass, Certificate } from './types';

// Components
import { Navbar } from './components/common/Navbar';
import { Footer } from './components/common/Footer';
import { SearchModal } from './components/common/SearchModal';
import { HeroSection } from './components/hero/HeroSection';
import { FeaturedCoursesSection } from './components/home/FeaturedCoursesSection';
import { LiveMasterclassesSection } from './components/home/LiveMasterclassesSection';
import { WhyChooseUsSection } from './components/home/WhyChooseUsSection';
import { TestimonialsSection } from './components/home/TestimonialsSection';
import { FaqSection } from './components/home/FaqSection';
import { CtaBanner } from './components/home/CtaBanner';
import { CourseDetailView } from './components/course/CourseDetailView';
import { CoursePlayer } from './components/player/CoursePlayer';
import { StudentDashboard } from './components/dashboard/StudentDashboard';
import { AdminLayout } from './components/admin/AdminLayout';
import { DeviceCheckModal } from './components/live/DeviceCheckModal';
import { VirtualClassroom } from './components/live/VirtualClassroom';
import { CheckoutModal } from './components/checkout/CheckoutModal';
import { CertificateModal } from './components/certificate/CertificateModal';

type AppView = 'home' | 'courses' | 'course-detail' | 'player' | 'dashboard' | 'admin' | 'live-room';

const MainAppContent: React.FC = () => {
  const { t, l } = useLanguage();
  const { user, isAdmin } = useAuth();

  // Navigation state
  const [currentView, setCurrentView] = useState<AppView>('home');
  const [selectedCourseSlug, setSelectedCourseSlug] = useState<string | null>(null);
  const [activePlayerCourse, setActivePlayerCourse] = useState<Course | null>(null);
  const [activePlayerLessonId, setActivePlayerLessonId] = useState<string | undefined>(undefined);
  const [activeLiveClass, setActiveLiveClass] = useState<LiveClass | null>(null);

  // Modals state
  const [isSearchOpen, setIsSearchOpen] = useState(false);
  const [checkoutCourse, setCheckoutCourse] = useState<Course | null>(null);
  const [viewingCertificate, setViewingCertificate] = useState<Certificate | null>(null);
  const [isDeviceCheckOpen, setIsDeviceCheckOpen] = useState(false);
  const [deviceCheckRoom, setDeviceCheckRoom] = useState<LiveClass | null>(null);

  // Live media streams prepared during device check
  const [liveStream, setLiveStream] = useState<MediaStream | null>(null);
  const [isLiveMuted, setIsLiveMuted] = useState(false);
  const [isLiveCameraOff, setIsLiveCameraOff] = useState(false);

  // Data
  const [courses, setCourses] = useState<Course[]>(() => StorageService.getCourses());
  const [liveClasses, setLiveClasses] = useState<LiveClass[]>(() => StorageService.getLiveClasses());
  const [siteSettings, setSiteSettings] = useState(() => StorageService.getSiteSettings());

  // Reload data when view changes
  useEffect(() => {
    setCourses(StorageService.getCourses());
    setLiveClasses(StorageService.getLiveClasses());
    setSiteSettings(StorageService.getSiteSettings());
  }, [currentView]);

  // Handle URL hash changes
  useEffect(() => {
    const handleHashChange = () => {
      const hash = window.location.hash.replace('#', '');
      if (hash.startsWith('/course/')) {
        const slug = hash.replace('/course/', '');
        setSelectedCourseSlug(slug);
        setCurrentView('course-detail');
      } else if (hash === '/courses') {
        setCurrentView('courses');
      } else if (hash === '/dashboard') {
        setCurrentView('dashboard');
      } else if (hash === '/admin') {
        setCurrentView('admin');
      } else if (hash.startsWith('/live/')) {
        const roomId = hash.replace('/live/', '');
        const targetClass = StorageService.getLiveClasses().find((c) => c.roomId === roomId);
        if (targetClass) {
          setDeviceCheckRoom(targetClass);
          setIsDeviceCheckOpen(true);
        }
      } else if (!hash || hash === '/') {
        setCurrentView('home');
      }
    };

    window.addEventListener('hashchange', handleHashChange);
    handleHashChange();
    return () => window.removeEventListener('hashchange', handleHashChange);
  }, []);

  const navigateTo = (view: AppView, slug?: string) => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    if (view === 'course-detail' && slug) {
      setSelectedCourseSlug(slug);
      window.location.hash = `/course/${slug}`;
    } else if (view === 'courses') {
      window.location.hash = '/courses';
    } else if (view === 'dashboard') {
      window.location.hash = '/dashboard';
    } else if (view === 'admin') {
      window.location.hash = '/admin';
    } else if (view === 'home') {
      window.location.hash = '/';
    }
    setCurrentView(view);
  };

  // Live session triggers
  const handleInitiateJoinLive = (liveClass: LiveClass) => {
    setDeviceCheckRoom(liveClass);
    setIsDeviceCheckOpen(true);
  };

  const handleDeviceCheckEnter = (
    stream: MediaStream | null,
    muted: boolean,
    cameraOff: boolean
  ) => {
    setLiveStream(stream);
    setIsLiveMuted(muted);
    setIsLiveCameraOff(cameraOff);
    setActiveLiveClass(deviceCheckRoom);
    setIsDeviceCheckOpen(false);
    setCurrentView('live-room');
  };

  const handleOpenCoursePlayer = (course: Course, lessonId?: string) => {
    setActivePlayerCourse(course);
    setActivePlayerLessonId(lessonId);
    setCurrentView('player');
    window.scrollTo({ top: 0 });
  };

  const activeCourse = courses.find((c) => c.slug === selectedCourseSlug);
  const instructor = activeCourse
    ? StorageService.getInstructors().find((i) => i.id === activeCourse.instructorId)
    : undefined;

  // View: LMS Video Player
  if (currentView === 'player' && activePlayerCourse) {
    return (
      <CoursePlayer
        course={activePlayerCourse}
        initialLessonId={activePlayerLessonId}
        onBackToCourse={() => navigateTo('course-detail', activePlayerCourse.slug)}
        onClaimCertificate={() => {
          const cert: Certificate = {
            id: `CERT-${Math.floor(100000 + Math.random() * 900000)}`,
            studentId: user.id,
            studentName: user.name,
            courseId: activePlayerCourse.id,
            courseTitle: activePlayerCourse.title.en,
            instructorName: 'Rohan Deshmukh',
            completionDate: new Date().toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            }),
            qrVerificationUrl: `https://skillforge.edu/verify/cert-${activePlayerCourse.id}`,
            grade: 'Excellence Distinction',
          };
          StorageService.issueCertificate(cert);
          setViewingCertificate(cert);
        }}
      />
    );
  }

  // View: Virtual Classroom
  if (currentView === 'live-room' && activeLiveClass) {
    return (
      <VirtualClassroom
        liveClass={activeLiveClass}
        initialStream={liveStream}
        initialMuted={isLiveMuted}
        initialCameraOff={isLiveCameraOff}
        onLeaveRoom={() => {
          setActiveLiveClass(null);
          navigateTo('home');
        }}
      />
    );
  }

  // View: Admin Panel
  if (currentView === 'admin') {
    return (
      <AdminLayout
        onBackToSite={() => navigateTo('home')}
        onJoinLiveClassAsHost={(cls) => handleInitiateJoinLive(cls)}
      />
    );
  }

  return (
    <div className="min-h-screen flex flex-col bg-[#0b0f19] text-slate-100 dark:bg-[#0b0f19] dark:text-slate-100 light:bg-slate-50 light:text-slate-900 transition-colors duration-300">
      {/* Optional Global Announcement Bar */}
      {siteSettings.announcementBarEnabled && (
        <div className="bg-gradient-to-r from-sky-600 via-indigo-600 to-purple-600 text-white text-xs font-semibold py-2 px-4 text-center">
          {siteSettings.announcementText}
        </div>
      )}

      {/* Main Navbar */}
      <Navbar
        currentView={currentView}
        onNavigate={(view) => navigateTo(view as AppView)}
        onOpenSearch={() => setIsSearchOpen(true)}
      />

      {/* Main View Switcher */}
      <main className="flex-1">
        {/* VIEW 1: HOME PAGE */}
        {currentView === 'home' && (
          <div>
            <HeroSection
              onExploreCourses={() => navigateTo('courses')}
              onJoinLiveClass={() => {
                const live = liveClasses.find((c) => c.status === 'live') || liveClasses[0];
                if (live) handleInitiateJoinLive(live);
              }}
            />

            <FeaturedCoursesSection
              courses={courses.filter((c) => c.status === 'published')}
              onSelectCourse={(slug) => navigateTo('course-detail', slug)}
              onEnrollCourse={(c) => setCheckoutCourse(c)}
            />

            <LiveMasterclassesSection
              liveClasses={liveClasses}
              onJoinLiveClass={(c) => handleInitiateJoinLive(c)}
            />

            <WhyChooseUsSection />

            <TestimonialsSection />

            <FaqSection />

            <CtaBanner onExplore={() => navigateTo('courses')} />
          </div>
        )}

        {/* VIEW 2: COURSES CATALOG */}
        {currentView === 'courses' && (
          <div className="pt-8">
            <FeaturedCoursesSection
              courses={courses.filter((c) => c.status === 'published')}
              onSelectCourse={(slug) => navigateTo('course-detail', slug)}
              onEnrollCourse={(c) => setCheckoutCourse(c)}
            />
          </div>
        )}

        {/* VIEW 3: COURSE DETAIL PAGE */}
        {currentView === 'course-detail' && activeCourse && (
          <CourseDetailView
            course={activeCourse}
            instructor={instructor}
            onBack={() => navigateTo('courses')}
            onStartLearning={(lessonId) => handleOpenCoursePlayer(activeCourse, lessonId)}
            onEnroll={(c) => setCheckoutCourse(c)}
          />
        )}

        {/* VIEW 4: STUDENT DASHBOARD */}
        {currentView === 'dashboard' && (
          <StudentDashboard
            onOpenCoursePlayer={(c, lessonId) => handleOpenCoursePlayer(c, lessonId)}
            onJoinLiveClass={(c) => handleInitiateJoinLive(c)}
            onBrowseCourses={() => navigateTo('courses')}
            onViewCertificate={(cert) => setViewingCertificate(cert)}
          />
        )}
      </main>

      {/* Global Footer */}
      <Footer onNavigate={(v) => navigateTo(v as AppView)} />

      {/* Search Modal */}
      <SearchModal
        isOpen={isSearchOpen}
        onClose={() => setIsSearchOpen(false)}
        onSelectCourse={(slug) => navigateTo('course-detail', slug)}
      />

      {/* Device Check Modal for Live Classrooms */}
      {isDeviceCheckOpen && deviceCheckRoom && (
        <DeviceCheckModal
          roomTitle={l(deviceCheckRoom.title)}
          onEnter={handleDeviceCheckEnter}
          onCancel={() => {
            setIsDeviceCheckOpen(false);
            setDeviceCheckRoom(null);
          }}
        />
      )}

      {/* Checkout Modal */}
      {checkoutCourse && (
        <CheckoutModal
          course={checkoutCourse}
          isOpen={true}
          onClose={() => setCheckoutCourse(null)}
          onSuccess={(c) => {
            setCheckoutCourse(null);
            handleOpenCoursePlayer(c);
          }}
        />
      )}

      {/* Verified Certificate Modal */}
      <CertificateModal
        certificate={viewingCertificate}
        onClose={() => setViewingCertificate(null)}
      />
    </div>
  );
};

export default function App() {
  return (
    <ThemeProvider>
      <LanguageProvider>
        <AuthProvider>
          <MainAppContent />
        </AuthProvider>
      </LanguageProvider>
    </ThemeProvider>
  );
}
