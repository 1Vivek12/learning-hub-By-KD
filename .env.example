# ==============================================================================
# LEARNING_HUB PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. CORE APPLICATION
# URL where the application is hosted (required for canonicals, sitemaps, emails)
NEXT_PUBLIC_APP_URL="https://learning-hub-by-kd.vercel.app"
# Node environment (development, production)
NODE_ENV="production"

# 2. DATABASE (Prisma / PostgreSQL)
# Connection string for production database
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
# Connection string for direct connections (often used in serverless environments)
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# 3. AUTHENTICATION & SECURITY
# Secret used for signing JWTs and session tokens (must be a strong 32+ char string)
AUTH_SECRET="generate-a-strong-secret-here"
# Optional: NextAuth URL (usually inferred, but good to be explicit in prod)
NEXTAUTH_URL="https://learning-hub-by-kd.vercel.app"

# 4. PAYMENT GATEWAY (Razorpay)
# Public key for client-side Razorpay initialization
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
# Private secret key for server-side order creation and signature verification
RAZORPAY_KEY_SECRET="your-razorpay-secret-here"
# Webhook secret for verifying Razorpay webhook payloads
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret-here"

# 5. LIVE CLASSROOM (LiveKit)
# Public URL for the LiveKit server
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"
# Private API Key
LIVEKIT_API_KEY="your-livekit-api-key"
# Private API Secret
LIVEKIT_API_SECRET="your-livekit-api-secret"

# 6. OBJECT STORAGE (AWS S3 / Cloudflare R2)
# Storage provider identifier ('s3', 'r2', or 'local')
STORAGE_PROVIDER="r2"
# Public URL for accessing assets if applicable
NEXT_PUBLIC_STORAGE_URL="https://assets.learning-hub-by-kd.vercel.app"
# S3/R2 Bucket Configuration (Server-side only)
STORAGE_BUCKET_NAME="learning-hub-assets"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# 7. EMAIL (SMTP Provider)
# Host configuration for production email dispatch
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="Learning Hub <no-reply@learning-hub-by-kd.vercel.app>"
SMTP_SECURE="true"
